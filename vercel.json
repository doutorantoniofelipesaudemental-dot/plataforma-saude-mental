{
  "version": 2,
  "builds": [
    { "src": "backend/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/index.js" },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": { "Cache-Control": "public, max-age=86400, must-revalidate" }
    },
    { "src": "/(favicon.svg|robots.txt|sitemap.xml)", "dest": "/public/$1" },
    { "src": "/google79736b5242e37404.html", "dest": "/public/google79736b5242e37404.html" },
    { "src": "/sitemap-index.xml", "dest": "/backend/index.js" },
    { "src": "/sitemap-artigos.xml", "dest": "/backend/index.js" },
    { "src": "/blog/?", "dest": "/backend/index.js" },
    { "src": "/artigo/[^/]+/?", "dest": "/backend/index.js" },
    { "src": "/privacidade/?", "dest": "/public/privacidade.html" },
    { "src": "/admin/?", "dest": "/public/admin.html" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
