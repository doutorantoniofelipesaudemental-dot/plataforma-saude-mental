{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": [
          "backend/data/reescritas/**",
          "public/*.html"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "drsaudemental.vercel.app" }],
      "status": 301,
      "headers": { "Location": "https://www.drantoniofelipemedico.com.br/$1" }
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400, must-revalidate"
      }
    },
    {
      "src": "/(favicon.svg|manifest.webmanifest|robots.txt|sitemap.xml)",
      "dest": "/public/$1"
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "Service-Worker-Allowed": "/"
      }
    },
    {
      "src": "/google79736b5242e37404.html",
      "dest": "/public/google79736b5242e37404.html"
    },
    {
      "src": "/sitemap-index.xml",
      "dest": "/backend/index.js"
    },
    {
      "src": "/sitemap-artigos.xml",
      "dest": "/backend/index.js"
    },
    {
      "src": "/sitemap-paginas.xml",
      "dest": "/backend/index.js"
    },
    {
      "src": "/blog/migracao/(migracao-saude-mental|criancas-adolescentes-migrantes-saude-mental|mulher-migrante-saude-mental|homem-migrante-saude-mental|trabalhador-migrante-saude-mental|estudante-migrante-saude-mental|refugiados-trauma-saude-mental|xenofobia-racismo-saude-mental-migrantes|familias-separadas-migracao-quem-fica|migrantes-como-buscar-ajuda-saude-mental-sus)([.]html)?/?",
      "status": 301,
      "headers": {
        "Location": "/artigo/$1"
      }
    },
    {
      "src": "/blog/migracao([.]html)?/?",
      "status": 301,
      "headers": {
        "Location": "/artigo/migracao-saude-mental"
      }
    },
    {
      "src": "/blog/?",
      "dest": "/backend/index.js"
    },
    {
      "src": "/instagram/?",
      "dest": "/backend/index.js"
    },
    {
      "src": "/artigo/[^/]+/?",
      "dest": "/backend/index.js"
    },
    {
      "src": "/privacidade/?",
      "dest": "/public/privacidade.html"
    },
    {
      "src": "/links/?",
      "dest": "/public/links.html"
    },
    {
      "src": "/mentoria/?",
      "dest": "/public/mentoria.html"
    },
    {
      "src": "/linkedin/?",
      "dest": "/public/linkedin.html"
    },
    {
      "src": "/youtube/?",
      "dest": "/public/youtube.html"
    },
    {
      "src": "/redes/previa/?",
      "dest": "/backend/index.js"
    },
    {
      "src": "/admin/?",
      "dest": "/public/admin.html"
    },
    {
      "src": "/(index[.]html)?",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/backend/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publicar-agendados",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/publicar-redes-v2",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/publicar-linkedin",
      "schedule": "30 22 * * 1,3,5"
    },
    {
      "path": "/api/cron/relatorio-redes",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/renovar-token-instagram",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/diagnostico-instagram",
      "schedule": "0 23 * * *"
    }
  ]
}
