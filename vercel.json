{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"console.log(\\\"site estatico em public e funcao em api: sem build\\\")\"",
  "installCommand": "npm install --no-audit",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{backend/data/reescritas/**,public/*.html}"
    }
  },
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "drsaudemental.vercel.app"
        }
      ],
      "destination": "https://www.drantoniofelipemedico.com.br/$1",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/migracao-saude-mental",
      "destination": "/artigo/migracao-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/migracao-saude-mental.html",
      "destination": "/artigo/migracao-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/criancas-adolescentes-migrantes-saude-mental",
      "destination": "/artigo/criancas-adolescentes-migrantes-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/criancas-adolescentes-migrantes-saude-mental.html",
      "destination": "/artigo/criancas-adolescentes-migrantes-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/mulher-migrante-saude-mental",
      "destination": "/artigo/mulher-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/mulher-migrante-saude-mental.html",
      "destination": "/artigo/mulher-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/homem-migrante-saude-mental",
      "destination": "/artigo/homem-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/homem-migrante-saude-mental.html",
      "destination": "/artigo/homem-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/trabalhador-migrante-saude-mental",
      "destination": "/artigo/trabalhador-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/trabalhador-migrante-saude-mental.html",
      "destination": "/artigo/trabalhador-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/estudante-migrante-saude-mental",
      "destination": "/artigo/estudante-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/estudante-migrante-saude-mental.html",
      "destination": "/artigo/estudante-migrante-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/refugiados-trauma-saude-mental",
      "destination": "/artigo/refugiados-trauma-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/refugiados-trauma-saude-mental.html",
      "destination": "/artigo/refugiados-trauma-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/xenofobia-racismo-saude-mental-migrantes",
      "destination": "/artigo/xenofobia-racismo-saude-mental-migrantes",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/xenofobia-racismo-saude-mental-migrantes.html",
      "destination": "/artigo/xenofobia-racismo-saude-mental-migrantes",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/familias-separadas-migracao-quem-fica",
      "destination": "/artigo/familias-separadas-migracao-quem-fica",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/familias-separadas-migracao-quem-fica.html",
      "destination": "/artigo/familias-separadas-migracao-quem-fica",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/migrantes-como-buscar-ajuda-saude-mental-sus",
      "destination": "/artigo/migrantes-como-buscar-ajuda-saude-mental-sus",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao/migrantes-como-buscar-ajuda-saude-mental-sus.html",
      "destination": "/artigo/migrantes-como-buscar-ajuda-saude-mental-sus",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao",
      "destination": "/artigo/migracao-saude-mental",
      "statusCode": 301
    },
    {
      "source": "/blog/migracao.html",
      "destination": "/artigo/migracao-saude-mental",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/podcast/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/podcast/feed.xml",
      "destination": "/api"
    },
    {
      "source": "/podcast",
      "destination": "/podcast.html"
    },
    {
      "source": "/podcast/",
      "destination": "/podcast.html"
    },
    {
      "source": "/sitemap-index.xml",
      "destination": "/api"
    },
    {
      "source": "/sitemap-artigos.xml",
      "destination": "/api"
    },
    {
      "source": "/sitemap-paginas.xml",
      "destination": "/api"
    },
    {
      "source": "/blog",
      "destination": "/api"
    },
    {
      "source": "/blog/",
      "destination": "/api"
    },
    {
      "source": "/instagram",
      "destination": "/api"
    },
    {
      "source": "/instagram/",
      "destination": "/api"
    },
    {
      "source": "/artigo/:slug",
      "destination": "/api"
    },
    {
      "source": "/artigo/:slug/",
      "destination": "/api"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/privacidade/",
      "destination": "/privacidade.html"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/links/",
      "destination": "/links.html"
    },
    {
      "source": "/mentoria",
      "destination": "/mentoria.html"
    },
    {
      "source": "/mentoria/",
      "destination": "/mentoria.html"
    },
    {
      "source": "/linkedin",
      "destination": "/linkedin.html"
    },
    {
      "source": "/linkedin/",
      "destination": "/linkedin.html"
    },
    {
      "source": "/youtube",
      "destination": "/youtube.html"
    },
    {
      "source": "/youtube/",
      "destination": "/youtube.html"
    },
    {
      "source": "/redes/previa",
      "destination": "/api"
    },
    {
      "source": "/redes/previa/",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/publicar-agendados",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/publicar-redes-v2",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/cron/publicar-linkedin",
      "schedule": "30 22 * * 1,3,5"
    },
    {
      "path": "/api/cron/relatorio-redes",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/renovar-token-instagram",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/diagnostico-instagram",
      "schedule": "0 23 * * *"
    }
  ]
}
