.vercel
node_modules
*.log
.DS_Store
carrosseis-instagram/
prontos_para_postar/

# Segredos reais nunca vão pro repo — mas .env.example é só documentação
# (placeholders vazios) e precisa ficar versionado pra quem clonar saber
# quais variáveis o projeto espera.
.env*
!.env.example

# Cache de bytecode Python e snapshots do Playwright MCP gerados durante
# verificacoes manuais — nao fazem parte do codigo do projeto.
__pycache__/
*.pyc
.playwright-mcp/

# Saídas do runner de testes E2E (npm run test:e2e).
test-results/
playwright-report/

# Backups locais de conteúdo do MongoDB (antes de edições diretas no banco).
# Nunca versionar: um backup de Agendamento/Contato conteria dados de
# pacientes (nome, e-mail, telefone) — LGPD.
backups/
narracoes-geradas/
prompt-mestre-plataforma.md
CONTEUDO_INSTAGRAM/rascunhos/
CONTEUDO_INSTAGRAM/aprovados/
CONTEUDO_INSTAGRAM/publicados/

# Trilhas licenciadas: não redistribuir (repositório público)
assets/audio/*.mp3

# Bases da regressão visual (por sistema, ~11 MB): geradas localmente por npm run test:visual
tests/e2e/*-snapshots/

# Saída de testes locais (ex.: bot:video-carrossel --saida=scratchpad)
scratchpad/

# Rascunhos reprovados nas checagens automáticas (versões antigas, não entram no repositório)
CONTEUDO_INSTAGRAM/pautas/rascunhos/_reprovados/

# Credenciais OAuth e configs/scripts locais do fallback LiteLLM
client_secret*.json*
litellm-config.yaml
Start-ClaudeFallback.ps1

# Pacote local de reescritas (não versionar)
reescritas-semana-1.zip

# Script local de envio de audios ao R2 (mantido so na maquina)
upload_r2.py
buscar_instagram_id.py

# Textos de importacao (481 HTML) fora do git
importacao-completa/
importacao-completa.zip

# Fila de redes (artes, arquivo)
conteudo/
relatorios/.cache-retratacoes.json

# Graphify (grafo local, regenerável) e seu ambiente
graphify-out/
tools-graphify/

# Mídia pesada das filas manuais do YouTube/LinkedIn (os textos .txt/.json/.md ficam versionados)
relatorios/youtube/fila-manual/**/*.mp4
relatorios/youtube/fila-manual/**/*.png
relatorios/youtube/canal/*.mp4
relatorios/youtube/propostas/**/*.mp4
relatorios/linkedin/fila-manual/**/*.pdf
relatorios/logs-agendador/

# Pasta de teste solta (16/10/2026): o Dr. Antônio apaga pelo Explorador de Arquivos
carrosseis-instagram/youtube/saude-mental-cuidador/short-resumo/

# gerado todo dia pela tarefa DrSM-LinkedIn-Lembrete (conteúdo do post do dia)
relatorios/linkedin/POST-DE-HOJE.md

# Instagram: fila manual (arquivos gerados) e estado do teste do carrossel
relatorios/redes/fila-manual/
relatorios/redes/teste-carrossel/estado.json

# LinkedIn: simulações do lote (não rastreadas; o lote rastreado só muda em execução real)
relatorios/linkedin/agendamento-lote.simulacao.json
relatorios/linkedin/agendamento-lote.simulacao.md

# YouTube: estado da regeração de mídia (gravado pela tarefa noturna; INDICE.md é atualizado pelo Claude Code)
