.vercel
node_modules
*.log
.DS_Store
carrosseis-instagram/
prontos_para_postar/

# Segredos reais nunca vão pro repo — mas .env.example é só documentação
# (placeholders vazios) e precisa ficar versionado pra quem clonar saber
# quais variáveis o projeto espera.
.env*
!.env.example

# Cache de bytecode Python e snapshots do Playwright MCP gerados durante
# verificacoes manuais — nao fazem parte do codigo do projeto.
__pycache__/
*.pyc
.playwright-mcp/

# Saídas do runner de testes E2E (npm run test:e2e).
test-results/
playwright-report/

# Backups locais de conteúdo do MongoDB (antes de edições diretas no banco).
# Nunca versionar: um backup de Agendamento/Contato conteria dados de
# pacientes (nome, e-mail, telefone) — LGPD.
backups/
narracoes-geradas/
prompt-mestre-plataforma.md
