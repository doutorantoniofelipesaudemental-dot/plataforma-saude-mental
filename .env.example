# Copie para .env (local) ou configure em Vercel > Settings > Environment Variables.

# String de conexão do MongoDB Atlas.
MONGODB_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority"

# Nome do banco (opcional — se a URI já tiver o banco, pode deixar em branco).
MONGODB_DB="drsaudemental"

# Token das rotas administrativas (listar agendamentos, criar/editar artigos).
# Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=""

# Porta do servidor local (opcional, padrão 3000).
PORT=3000

# --- Publicação no Instagram (scripts Python na raiz) ---

# ID numérico da conta Instagram Business/Creator e token de longa duração
# (60 dias, permissões instagram_basic + instagram_content_publish +
# pages_read_engagement). Usados por publicar_instagram.py.
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# App ID e App Secret do app Meta (developers.facebook.com/apps > seu app >
# Configurações > Básico) — só precisam disso para RENOVAR o
# INSTAGRAM_ACCESS_TOKEN (troca de token curto por longa duração, grant_type
# fb_exchange_token). Usados por publicar_instagram.py:renovar_token_longa_duracao()
# e por backend/tools/renovar-token-instagram.js (`npm run renovar-token-instagram`).
# App Secret é credencial sensível — nunca cole em chat/PR, só direto no .env.local.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Token de um Blob store público da Vercel (Storage > Blob > Create > Connect
# to Project, ou `vercel env pull .env.local`). Usado por
# preparar_midia_publica.py para hospedar as imagens/vídeos locais de
# carrosseis-instagram/ em URL HTTPS antes de alimentar --midias, e também
# pelo backend Node (backend/routes/midia.js) para guardar a narração TTS e a
# capa gerada de cada artigo (PUT /api/artigos/:slug/midia/audio|capa).
BLOB_READ_WRITE_TOKEN=""

# --- Geração de legenda + publicação via Composio (post_instagram.py) ---

# Chave da API da Anthropic, usada para gerar a legenda do dia com Claude.
ANTHROPIC_API_KEY=""

# Chave da API da Composio (app.composio.dev) e o id do usuário/entidade que
# conectou a conta Instagram Business/Creator pelo dashboard da Composio.
COMPOSIO_API_KEY=""
COMPOSIO_USER_ID="default"

# URL HTTPS usada quando `post_instagram.py publicar` é chamado sem
# --media-url (ex.: pela tarefa agendada diária via Publish-Instagram.ps1).
INSTAGRAM_MEDIA_URL_PADRAO=""

# --- backend/lib/socialPublisher.js (tripla checagem + Instagram/LinkedIn) ---
# Reaproveita INSTAGRAM_ACCOUNT_ID e INSTAGRAM_ACCESS_TOKEN definidos acima
# (mesma conta, mesmo token — não duplique). Novas variáveis, só deste módulo:

# Token de acesso da LinkedIn API (produto Marketing Developer Platform ou
# Community Management API, com permissão w_organization_social ou w_member_social).
LINKEDIN_ACCESS_TOKEN=""

# URN do autor do post — organização (ex.: urn:li:organization:12345678) ou
# pessoa (ex.: urn:li:person:AbCdEfGhIj). Obrigatório: o token sozinho não
# identifica em nome de quem postar.
LINKEDIN_AUTHOR_URN=""

# Interruptor de segurança: com "true", salvar um artigo com status:"aprovado"
# (via PUT/POST /api/artigos) dispara a publicação REAL automática no
# Instagram/LinkedIn, sem pedir confirmação. Ausente ou qualquer valor
# diferente de "true" (inclusive vazio) = só monta e loga os pacotes, nunca
# publica sozinho. Ligue só quando tiver revisado o fluxo com confirmar:true
# manual pelo menos uma vez. Ver Seção 20 do CLAUDE.md.
AUTO_PUBLICAR_REDES="false"

# Narração dos artigos (npm run narrar) — Azure Speech, SÓ no .env local.
# Nunca na Vercel nem no repositório. Ver CLAUDE.md, Seção 20-quinquies.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# Bot de mídias (npm run bot:gerar-posts) — LLM gratuito, SÓ no .env local.
# Gemini é o principal; Groq, a reserva. Basta uma das duas chaves.
GEMINI_API_KEY=""
GROQ_API_KEY=""
# Opcionais: GEMINI_MODEL (padrão gemini-flash-latest), GROQ_MODEL (padrão openai/gpt-oss-120b)
