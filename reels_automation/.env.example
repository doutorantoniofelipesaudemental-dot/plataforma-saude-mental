# Copie para .env nesta pasta (reels_automation/.env) e preencha os valores.
# As credenciais de publicacao no Instagram (INSTAGRAM_ACCOUNT_ID,
# INSTAGRAM_ACCESS_TOKEN, BLOB_READ_WRITE_TOKEN, COMPOSIO_API_KEY, etc.) NAO
# ficam aqui — ja existem em ../.env.local na raiz do repositorio e sao lidas
# diretamente pelos scripts publicar_instagram.py / post_instagram.py /
# preparar_midia_publica.py, que este pipeline chama como subprocesso.

# --- Ollama (geracao de roteiro) ---
# Ollama roda local, normalmente sem necessidade de chave. Ajuste apenas se
# a instancia estiver em outra maquina/porta.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="deepseek-r1:8b"

# --- Stable Diffusion ---
# Se usar o backend "automatic1111", aponte para a API do WebUI (Settings >
# API > habilitar "--api" na inicializacao do AUTOMATIC1111).
SD_API_URL="http://127.0.0.1:7860"

# Se usar o backend "diffusers" (execucao local via Python, sem WebUI), pode
# ser necessario um token da Hugging Face para baixar o modelo na primeira vez.
HF_TOKEN=""

# --- WhisperX ---
# "cpu" funciona em qualquer maquina; troque para "cuda" se houver GPU NVIDIA
# com CUDA instalado (recomendado para acelerar a transcricao).
WHISPERX_DEVICE="cpu"
WHISPERX_COMPUTE_TYPE="int8"

# Token da Hugging Face necessario apenas para o modelo de diarizacao/alinhamento
# do WhisperX na primeira execucao (aceite os termos dos modelos pyannote).
HUGGINGFACE_TOKEN=""

# --- Edge-TTS ---
EDGE_TTS_VOICE="pt-BR-AntonioNeural"

# --- Publicacao (opcional, sobrescreve o padrao de settings.json) ---
# "graph" usa publicar_instagram.py (Meta Graph API direta).
# "composio" usa post_instagram.py (Composio + Claude para a legenda).
INSTAGRAM_PUBLISH_METHOD="graph"
