{
  "name": "drsaudemental",
  "version": "1.0.0",
  "private": true,
  "description": "Site e blog do Portal de Saúde Mental Doutor Antônio Felipe Garabito",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js --carregar-banco",
    "dev": "node --env-file-if-exists=.env --watch index.js",
    "seed": "node --env-file-if-exists=.env backend/seed.js",
    "seed:reset": "node --env-file-if-exists=.env backend/seed.js --reset",
    "carrosseis": "node --env-file-if-exists=.env backend/tools/gerar-carrosseis.js",
    "publicar-redes": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/tools/publicar-redes.js",
    "renovar-token-instagram": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/tools/renovar-token-instagram.js",
    "test:e2e": "playwright test",
    "prepare": "husky || true",
    "verificar-segredos": "node scripts/verificar-segredos.js --historico",
    "test:unit": "node --test tests/unit/",
    "test": "npm run test:unit && npm run test:e2e",
    "importar-reescritas": "node --env-file-if-exists=.env backend/tools/importar-reescritas.js",
    "narrar": "node --env-file-if-exists=.env backend/tools/narrar-artigos.js",
    "bot:ideacao": "node scripts/bot-ideacao.js",
    "bot:gerar-posts": "node scripts/bot-gemini.js",
    "bot:gemini": "node scripts/bot-gemini.js",
    "bot:narracoes": "node --env-file-if-exists=.env backend/tools/narrar-artigos.js --pendentes --limite=20 --enviar",
    "bot:aprovar": "node scripts/bot-aprovar.js",
    "bot:publicar": "node scripts/bot-publicar.js",
    "youtube:autorizar": "node scripts/youtube-autorizar.js",
    "bot:video-carrossel": "node scripts/bot-video-carrossel.js",
    "bot:matriz": "node scripts/bot-matriz.js",
    "bot:elevenlabs": "node scripts/bot-elevenlabs.js",
    "bot:previa-visual": "node scripts/bot-previa-visual.js",
    "test:visual": "playwright test tests/e2e/visual-miniapps.spec.js",
    "test:visual:atualizar": "playwright test tests/e2e/visual-miniapps.spec.js --update-snapshots",
    "proxy:github": "node scripts/proxy-github.js",
    "auditoria:seo": "node scripts/auditoria-seo.js",
    "ingestao:rascunhos": "node --env-file-if-exists=.env backend/scripts/ingestaoRascunhos.js",
    "audit:instagram": "node backend/scripts/auditoriaInstagram.js",
    "publish:autonomous": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/tools/publicar-autonomo.js",
    "publish:autonomous:teste": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/tools/publicar-autonomo.js --teste",
    "ollama:status": "node -e \"require('./backend/lib/ollamaAdapter').modelosInstalados().then(console.log)\"",
    "auditoria": "node --env-file-if-exists=.env backend/scripts/auditoria.js",
    "rotina-semanal": "node --env-file-if-exists=.env scripts/rotinaSemanal.js",
    "importar-tudo": "node --env-file-if-exists=.env backend/scripts/importarTudo.js",
    "build": "npm --prefix apps/plataforma-saude-mental run build",
    "redes:arquivar": "node --env-file-if-exists=.env backend/scripts/redes/arquivarFilaAntiga.js",
    "redes:gerar": "node --env-file-if-exists=.env backend/scripts/redes/gerarFila.js",
    "redes:enviar": "node --env-file-if-exists=.env backend/scripts/redes/enviarFila.js",
    "redes:publicar": "node --env-file-if-exists=.env backend/scripts/redes/publicarRedes.js",
    "redes:relatorio": "node --env-file-if-exists=.env backend/scripts/redes/relatorioSemanal.js",
    "ciclo-narracao": "node --env-file-if-exists=.env scripts/cicloNarracao.js",
    "youtube:fila": "node --env-file-if-exists=.env scripts/youtube/montarFila.js",
    "youtube:publicar": "node --env-file-if-exists=.env scripts/youtube/publicarYoutube.js",
    "youtube:playlists": "node --env-file-if-exists=.env scripts/youtube/criarPlaylists.js",
    "linkedin:conteudo": "node --env-file-if-exists=.env scripts/linkedin/gerarConteudo.js",
    "linkedin:autorizar": "node scripts/linkedin-autorizar.js",
    "youtube:upload-teste": "node --env-file-if-exists=.env scripts/youtube/testeUploadPrivado.js --confirmar"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@vercel/blob": "^2.8.0",
    "archiver": "^8.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^13.3.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.46.0",
    "mongoose": "^9.9.5",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "husky": "^9.1.7"
  }
}
