{
  "enabledMcpjsonServers": ["elevenlabs"],
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Skill",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx playwright:*)",
      "Bash(node:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "PowerShell(Get-ScheduledTask:*)",
      "PowerShell(Get-ScheduledTaskInfo:*)",
      "PowerShell(Enable-ScheduledTask:*)",
      "PowerShell(Disable-ScheduledTask:*)",
      "PowerShell(Start-ScheduledTask:*)",
      "mcp__chrome-devtools",
      "mcp__plugin_bio-research_pubmed",
      "mcp__claude_ai_Vercel__list_projects",
      "mcp__claude_ai_Vercel__get_project",
      "mcp__claude_ai_Vercel__list_deployments",
      "mcp__claude_ai_Vercel__get_deployment",
      "mcp__claude_ai_Vercel__list_deployment_events",
      "mcp__claude_ai_Vercel__get_runtime_logs",
      "mcp__claude_ai_Vercel__get_runtime_errors",
      "mcp__claude_ai_Vercel__list_teams",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./client_secret*.json)",
      "Read(./upload_r2.py)",
      "Edit(./.env*)",
      "Write(./.env*)",
      "Edit(./client_secret*.json)",
      "Write(./client_secret*.json)",
      "Edit(./.claude/settings*.json)",
      "Write(./.claude/settings*.json)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(vercel env:*)",
      "Bash(printenv:*)",
      "PowerShell(Get-Content .env*)",
      "PowerShell(Get-Content ./.env*)",
      "PowerShell(Get-Content .\\.env*)",
      "PowerShell(Select-String .env*)",
      "PowerShell(vercel env:*)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --delete:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(del /s:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(rm -r:*)",
      "PowerShell(del /s:*)",
      "Bash(gh repo delete:*)",
      "PowerShell(gh repo delete:*)",
      "Bash(vercel remove:*)",
      "Bash(vercel env rm:*)",
      "Bash(vercel env add:*)",
      "PowerShell(vercel remove:*)",
      "mcp__claude_ai_Vercel__create_project_env",
      "mcp__claude_ai_Vercel__edit_project_env",
      "mcp__claude_ai_Windsor_ai__execute_action"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda.js\""
          }
        ]
      }
    ]
  }
}
